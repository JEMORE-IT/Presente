# Modalità di esecuzione: "true" per test locali senza Azure, "false" in produzione (Dokploy)
DEV_MODE=false

# Microsoft Graph API / Azure Entra ID
MS_TENANT_ID="your-tenant-id"
MS_CLIENT_ID="your-client-id"
MS_CLIENT_SECRET="your-client-secret"
MS_DRIVE_ID="your-drive-id"

# Segreti per calcolo HMAC dei QR Code e per chiamate interne server-to-server
QR_SECRET_KEY="generate-a-strong-random-qr-secret-key"
INTERNAL_API_SECRET="generate-a-strong-random-internal-api-secret"

# External PostgreSQL Database URL for member sync (optional)
POSTGRES_SYNC_URL="postgresql://user:password@host:5432/dbname"

# Local DB override (optional, defaults to SQLite presente.db)
# DATABASE_PATH="/app/data/presente.db"

# Allowed CORS origins (comma-separated)
CORS_ORIGINS="https://presente.jemore.it,http://localhost:3000"
