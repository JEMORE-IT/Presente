# Microsoft Graph API credentials
MS_TENANT_ID="your-tenant-id"
MS_CLIENT_ID="your-client-id"
MS_CLIENT_SECRET="your-client-secret"
MS_DRIVE_ID="your-drive-id"

# External PostgreSQL Database URL for member sync (optional, only if syncing from external JEMORE DB)
POSTGRES_SYNC_URL="postgresql://user:password@host:5432/dbname"

# Local DB override (optional, defaults to SQLite presente.db)
# DATABASE_URL="sqlite:////app/presente.db"

# Allowed CORS origins (optional, comma-separated)
# CORS_ORIGINS="https://presente.jemore.it"
